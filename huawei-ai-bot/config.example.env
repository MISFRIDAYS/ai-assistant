# ===== ค่าที่ต้องใส่ =====
# Token จาก @BotFather ใน Telegram
TELEGRAM_BOT_TOKEN=
# API key จาก https://console.anthropic.com
ANTHROPIC_API_KEY=
# Telegram ID ของคนที่อนุญาตให้ใช้ (ส่ง /id หาบอทเพื่อดู) คั่นหลายคนด้วย ,
ALLOWED_USER_IDS=

# ===== เลือก AI =====
# claude = ใช้ Claude เป็นหลัก / gemini = ใช้ Gemini อย่างเดียว
LLM_PROVIDER=claude
# ถ้า Claude ใช้ไม่ได้ (เครดิตหมด/ล่ม) สลับไป Gemini อัตโนมัติ (gemini / none)
LLM_FALLBACK=gemini
# API key ฟรีจาก https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Cloud AI รายเดือน (Chutes / NanoGPT / Synthetic — API แบบ OpenAI) ใช้: LLM_PROVIDER=cloud
CLOUD_API_KEY=
# ว่าง = Chutes (https://llm.chutes.ai/v1)
CLOUD_BASE_URL=
# ตัวหลัก (ดูรูป + สั่งงาน + คุมมือถือ) / ตัวสำรองเมื่อตัวหลักเต็ม
CLOUD_MODEL=Qwen/Qwen3.5-397B-A17B-TEE
CLOUD_MODEL_BACKUP=moonshotai/Kimi-K3-TEE
# Ollama Cloud: OLLAMA_URL=https://ollama.com + คีย์จาก ollama.com/settings/keys
OLLAMA_API_KEY=

# ===== ค่าเสริม (ไม่ต้องแก้ก็ได้) =====
BOT_NAME=ผู้ช่วย Huawei
# รุ่น Claude ดูรายชื่อล่าสุดที่ https://docs.claude.com/en/docs/about-claude/models
# เร็วและถูก: claude-haiku-4-5  /  ฉลาดกว่าแต่ช้ากว่า: claude-sonnet-4-6
CLAUDE_MODEL=claude-haiku-4-5
MAX_TOKENS=2048
# ===== คุมค่าใช้จ่าย =====
# งบ Claude ต่อวัน (USD) ใช้เกินแล้วสลับไปตัวฟรี (Gemini/Groq) ถึงเที่ยงคืน บอทยังทำงาน 24 ชม. · 0 = ไม่จำกัด
DAILY_BUDGET_USD=0.5
# รอบที่ AI เรียกเครื่องมือได้ต่อ 1 คำสั่ง (เดิม 25)
MAX_STEPS=15
# โหมดมองจอ: ส่งภาพหน้าจอได้กี่ภาพต่องาน (เดิม 14)
VISION_MAX_STEPS=10
# ตอบแชทแทนด้วย AI ได้กี่ข้อความต่อวัน · 0 = ไม่จำกัด
AUTOREPLY_DAILY_MAX=60
# ให้ AI ลองซ่อมโค้ดตัวเองได้กี่ครั้งต่อวัน
REPAIR_DAILY_MAX=3
# 1 = เปิดค้นหาเว็บ, 0 = ปิด
ENABLE_WEB_SEARCH=1
# 1 = อนุญาตให้ AI รันคำสั่ง shell (ต้องกดอนุญาตทุกครั้ง), 0 = ปิด
ENABLE_SHELL=1
# จำนวนข้อความที่จำย้อนหลัง
MAX_HISTORY=20
# เวลารอให้กดอนุญาต (วินาที)
CONFIRM_TIMEOUT=120
TIMEZONE_OFFSET_HOURS=7
# 1 = โหมดทดสอบบนคอม (จำลองข้อมูลมือถือ)
MOCK_PHONE=0
# 1 = เปิดการควบคุมหน้าจอผ่าน ADB ไร้สาย (เปิดแอป แตะ พิมพ์แชท รับสาย)
ENABLE_ADB=1

# ===== เสียง =====
# API key แปลงเสียงเป็นข้อความ (ฟรี) จาก https://console.groq.com/keys
GROQ_API_KEY=
# ส่งข้อความเสียงมาใน Telegram → บอทตอบกลับเป็นเสียงด้วย
VOICE_REPLY=1
# 1 = พูดคำตอบออกลำโพงแท็บเล็ตทุกครั้ง (แม้สั่งผ่าน Telegram)
SPEAK_ON_DEVICE=0
# โหมดคุยบนแท็บเล็ต: ฟังครั้งละกี่วินาที
VOICE_LISTEN_SECONDS=6
# หลังตอบ ฟังคำถามต่อโดยไม่ต้องเรียกชื่อกี่วินาที (เดิม 15 · น้อย = ไม่ค่อยรับเสียงทีวีเป็นคำสั่ง)
FOLLOWUP_SECONDS=8
# สั่งด้วยเสียง: ส่งข้อความ/โพสต์/แชร์ ต้องยืนยันก่อน (1 = ถาม, 0 = ส่งเลย)
VOICE_CONFIRM_SEND=1
# คำปลุก (โหมด --wake) คั่นด้วย ,
WAKE_WORDS=ผู้ช่วย,หวัดดีบอท,เฮ้บอท

# ---- ซ่อมตัวเอง (self_heal.py)
# ask = ซ่อมโค้ดได้เองแต่ถามก่อนใช้จริง (ค่าเริ่มต้น) · auto = บัคที่เกิดซ้ำซ่อม+ใช้เลยถ้าผ่านเทสต์ · off = ปิดการแก้โค้ด
SELF_REPAIR=ask
# รุ่น AI ที่ใช้ซ่อมโค้ด (ว่าง = ใช้ CLAUDE_MODEL) แนะนำ claude-sonnet-4-6 ขึ้นไป
REPAIR_MODEL=
